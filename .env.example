# Ethereum mainnet RPC (e.g. Alchemy, Infura, or your own node)
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# Arbitrum One RPC
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Trading wallet private key (0x prefixed)
PRIVATE_KEY=0x...

# Google Gemini API key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=AIza...

# Maximum USD value per single swap (hard limit enforced by runtime)
MAX_TRADE_USDC=10

# How often to run the agentic loop (seconds, minimum 10)
POLL_INTERVAL_SECONDS=30

# Gemini model to use (optional, defaults to gemini-2.0-flash)
# MODEL=gemini-2.0-flash

# ── Mnemos / 0G memory layer (optional) ──────────────────────────────────────
# All 10 vars must be set to enable on-chain trade memory snapshots.
# If any are missing, Mnemos is silently disabled.

# 0G Network RPC endpoint
# OG_RPC_URL=https://rpc-testnet.0g.ai

# 0G Storage node URL
# OG_STORAGE_NODE=https://storage-testnet.0g.ai

# 0G chain ID (16601 for testnet)
# OG_CHAIN_ID=16601

# Deployed Mnemos registry contract address
# MNEMO_REGISTRY_ADDRESS=0x...

# Deployed Mnemos marketplace contract address
# MNEMO_MARKETPLACE_ADDRESS=0x...

# Listing price in wei (buy outright)
# MNEMO_BUY_PRICE=1000000000000000000

# Rent price per day in wei
# MNEMO_RENT_PRICE_PER_DAY=100000000000000000

# Fork price in wei
# MNEMO_FORK_PRICE=500000000000000000

# Royalty in basis points (e.g. 500 = 5%)
# MNEMO_ROYALTY_BPS=500

# Use in-memory storage mock instead of real 0G Storage (true/false, default false)
# MNEMO_STORAGE_MOCK=false
