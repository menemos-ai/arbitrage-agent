# Arbitrum One RPC (required)
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Ethereum mainnet RPC (optional — defaults to public https://eth.llamarpc.com for price monitoring)
# Without EXECUTOR_ETH the agent never executes on mainnet, only monitors prices.
# ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# Trading wallet private key (0x prefixed)
PRIVATE_KEY=0x...

# Maximum USD value per single flash loan borrow (hard limit enforced by runtime)
# $10 is too small — SushiSwap 0.3% + UniV3 0.05% fees exceed any realistic spread at that size.
# Use at least 1000 for meaningful arbitrage. Start with 1000, increase if opportunities appear.
MAX_TRADE_USDC=1000

# ── ArbitrageExecutor contract addresses ──────────────────────────────────────
# Dry run (simulate only, no transaction sent):
#   npm run deploy:dry-run:arb   ← check gas cost first
#   npm run deploy:dry-run:eth
#
# Deploy (requires env vars below):
#   npm run deploy:arb
#   npm run deploy:eth
#
# IMPORTANT: These constructor args are baked into the contract permanently.
# Use the correct addresses for the network you are deploying to.
#
# ── Arbitrum One (use these when running deploy:arb) ──────────────────────────
# NOTE: Uses USDC.e (bridged) — SushiSwap V2 native-USDC pool has only ~$23K TVL, unusable.
BALANCER_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8
WETH_ADDRESS=0x82aF49447D8a07e3bd95BD0d56f35241523fBab1
USDC_ADDRESS=0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8
V2_ROUTER=0x1b02dA8Cb0d097eB8D57A175b88c7D8b47997506
V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
V3_QUOTER=0x61fFE014bA17989E743c5F6cB21bF9697530B21e
#
# ── Ethereum mainnet (swap these in when running deploy:eth) ──────────────────
# BALANCER_VAULT=0xBA12222222228d8Ba445958a75a0704d566BF2C8
# WETH_ADDRESS=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
# USDC_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# V2_ROUTER=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
# V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
# V3_QUOTER=0x61fFE014bA17989E743c5F6cB21bF9697530B21e

# After deploy, paste addresses here:
# EXECUTOR_ETH=0x...
# EXECUTOR_ARB=0x...

# How often to run the agentic loop (seconds, minimum 10)
POLL_INTERVAL_SECONDS=30

# ── AI Provider ───────────────────────────────────────────────────────────────
# Only ONE key is needed. The agent auto-detects the provider from whichever
# key is present (priority: Groq → Gemini → Claude → OpenAI).
#
# Set MODEL only if you want to override the default model for that provider:
#   Groq default    : llama-3.3-70b-versatile  ← FREE (recommended)
#   Gemini default  : gemini-2.0-flash
#   Claude default  : claude-sonnet-4-6
#   OpenAI default  : gpt-4o
#
# MODEL=llama-3.3-70b-versatile
# MODEL=gemini-2.0-flash
# MODEL=claude-sonnet-4-6
# MODEL=gpt-4o

# Groq API key (FREE tier) — https://console.groq.com/
# Supports: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
# GROQ_API_KEY=gsk_...

# Google Gemini API key — https://aistudio.google.com/
# GEMINI_API_KEY=AIza...

# Anthropic API key — https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — https://platform.openai.com/
# OPENAI_API_KEY=sk-...

# ── Mnemos / 0G memory layer (optional) ──────────────────────────────────────
# All 9 vars must be set to enable on-chain trade memory snapshots.
# If any are missing, Mnemos is silently disabled.

# 0G Network RPC endpoint
# OG_RPC_URL=https://rpc-testnet.0g.ai

# 0G Storage node URL
# OG_STORAGE_NODE=https://storage-testnet.0g.ai

# 0G chain ID (16601 for testnet)
# OG_CHAIN_ID=16601

# Deployed Mnemos registry contract address
# MNEMO_REGISTRY_ADDRESS=0x...

# Deployed Mnemos marketplace contract address
# MNEMO_MARKETPLACE_ADDRESS=0x...

# Listing price in wei (buy outright)
# MNEMO_BUY_PRICE=1000000000000000000

# Rent price per day in wei
# MNEMO_RENT_PRICE_PER_DAY=100000000000000000

# Fork price in wei
# MNEMO_FORK_PRICE=500000000000000000

# Royalty in basis points (e.g. 500 = 5%)
# MNEMO_ROYALTY_BPS=500

# Use in-memory storage mock instead of real 0G Storage (true/false, default false)
# MNEMO_STORAGE_MOCK=false
