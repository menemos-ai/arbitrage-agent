# Ethereum mainnet RPC (e.g. Alchemy, Infura, or your own node)
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

# Arbitrum One RPC
ARB_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY

# Trading wallet private key (0x prefixed)
PRIVATE_KEY=0x...

# Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Maximum USD value per single swap (hard limit enforced by runtime)
MAX_TRADE_USDC=10

# How often to run the agentic loop (seconds, minimum 10)
POLL_INTERVAL_SECONDS=30

# Claude model to use (optional, defaults to claude-opus-4-7)
# MODEL=claude-opus-4-7
